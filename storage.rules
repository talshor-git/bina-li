rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /post-images/{uid}/{fileName} {
      /* התמונות ציבוריות לקריאה (מוצגות בפיד) */
      allow read: if true;

      /* כל משתמש מחובר (גם אנונימית) יכול להעלות תמונה משלו, עד 15MB, סוג תמונה בלבד */
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      /* מחיקת תמונה: כל משתמש מחובר (כדי לאפשר גם מחיקה ממצב מנהל) */
      allow delete: if request.auth != null;
    }
  }
}
